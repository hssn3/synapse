NODE_ENV=production
PORT=3000
JWT_SECRET=CHANGE_ME_به_یک_رشته_تصادفی_طولانی
JWT_EXPIRES_IN=8h
SESSION_COOKIE_NAME=sid
BCRYPT_ROUNDS=12
# ---- سقف نرخ درخواست ----
# فقط تلاش‌های *ناموفق* ورود شمرده می‌شوند، وگرنه در بیمارستانی که همه پشت یک IP
# هستند نفر ششمی که وارد می‌شد پشت در می‌ماند.
LOGIN_RATE_LIMIT_MAX=5
# سقف عمومی. برای کاربر واردشده به ازای جلسه‌ی خودش شمرده می‌شود، نه IP.
# مقدار قبلی ۱۰۰ بود و کم بود: این یک SPA است و یک بازدید کوتاه ~۲۴ درخواست
# مصرف می‌کند، پس چند کارمندِ هم‌زمانِ یک مرکز کل بیمارستان را قفل می‌کردند.
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MS=900000
# فقط روی *ارسال* فرم‌های عمومی اعمال می‌شود، نه خواندن صفحه‌شان. مقدار قبلی ۲۰ بود
# و چون شاملِ خواندن هم می‌شد، با حدود ۲۰ بار باز کردنِ فرم نظرسنجی، فرم برای کل
# آن شبکه از کار می‌افتاد.
PUBLIC_FORM_RATE_LIMIT_MAX=60
MAX_UPLOAD_SIZE_MB=5

# ---- مسیر داده‌ی ماندگار ----
# مهم‌ترین تنظیم استقرار. ریشه‌ی دیتابیس، آپلودها و بکاپ‌هاست.
# روی سرور حتماً به یک دیسک/والیوم ماندگار اشاره کند، وگرنه با هر دیپلوی همه‌ی
# داده‌ی بیمارستان پاک می‌شود. اگر ست نشود، همه‌چیز داخل پوشه‌ی پروژه می‌ماند
# (برای کار محلی مناسب است، برای سرور نه).
#   DATA_DIR=/data  →  /data/database  و  /data/uploads  و  /data/backups
# DATA_DIR=/data
# این دوتا فقط وقتی لازم‌اند که بخواهی از DATA_DIR جدایشان کنی:
# UPLOAD_DIR=/data/uploads
# BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=30
# بکاپ خودکار روزانه‌ی دیتابیس که سرور خودش در database/backups/auto-YYYY-MM-DD.db می‌سازد
# (جدا از BACKUP_DIR بالا که مخصوص اسکریپت‌های CLI scripts/backup.js و scripts/restore.js است)
AUTO_BACKUP_RETENTION_DAYS=14
DEFAULT_HOSPITAL_NAME=بیمارستان نمونه

# ---- دروازه‌ی ورود ----
# فقط پیش‌فرضِ نصب تازه است. به‌محض اینکه سوپرادمین از پنل خودش تنظیمش کند،
# انتخاب او همیشه برنده است و این متغیر دیگر بازنویسی‌اش نمی‌کند.
# 0 = ورود با کلیک روی کاشی سمت، بدون رمز (مناسب دمو)
# 1 = رمز عبور اجباری
# REQUIRE_PASSWORD=0

# ---- تماس در سایت عمومی ----
# اگر هیچ‌کدام ست نشود، بخش «تماس با ما» و لینک‌های منویش پنهان می‌مانند —
# که از نشان‌دادن یک نشانی نمونه بهتر است.
# SUPPORT_EMAIL=info@example.ir
# SUPPORT_PHONE=+982100000000

# نشانی عمومی سامانه — در لینک‌های ایمیل/پیامک و QR مراکز استفاده می‌شود.
# روی سرور واقعی حتماً ست شود، وگرنه لینک‌ها به localhost اشاره می‌کنند.
BASE_URL=https://example.ir

# ---- پایگاه داده ----
# پیش‌فرض SQLite است (فایل database/hospital.db) و هیچ تنظیمی نمی‌خواهد.
# به‌محض ست‌شدن DB_HOST، سامانه خودکار به PostgreSQL سوییچ می‌کند
# (src/config/database.js). برای استقرار واقعی/چندکاربره PostgreSQL توصیه می‌شود.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=hospital
# DB_USER=hospital
# DB_PASSWORD=

# نام کوکی‌های نشست (به‌ندرت نیاز به تغییر — فقط اگر چند نمونه از این اپ پشت یک دامنه‌ی مشترک اجرا شود)
SUPER_SESSION_COOKIE_NAME=ssid
PREVIEW_COOKIE_NAME=pvid

# زمان‌بند ریمایندرهای خروجی (ایمیل/پیامک) — هر چند ساعت یک‌بار چک شود (۱ تا ۱۶۸). بدون SMTP/SMS
# پیکربندی‌شده در ادامه، این زمان‌بند اصلاً اجرا نمی‌شود (ریمایندرها همچنان در کارتابل دیده می‌شوند).
REMINDER_CRON_HOURS=6

# اختیاری — کانال خروجی ایمیل/پیامک برای ریمایندرها. اگر خالی بماند، فقط در کارتابل کاربر دیده می‌شود.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="بیمارستان <no-reply@example.com>"
# SMS_PROVIDER=kavenegar
# SMS_API_KEY=
# SMS_FROM=10004346
